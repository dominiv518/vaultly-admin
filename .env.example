# Base URL of the Vaultly backend (backend/src/server.js).
# Copy this file to .env.local for local development - Vite auto-loads it
# and it's already gitignored. Locally you can usually leave it unset,
# since src/lib/api.js falls back to http://localhost:3000.
#
# For the deployed (Vercel) site, set VITE_API_URL in the Vercel project's
# dashboard under Settings -> Environment Variables, pointing at wherever
# the backend is actually hosted (see handoff notes - it can't run on
# Vercel itself).
VITE_API_URL=http://localhost:3000
